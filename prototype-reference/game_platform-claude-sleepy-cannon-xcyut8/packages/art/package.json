{
  "name": "@gp/art",
  "private": true,
  "type": "module",
  "description": "The drawing module for kit: code games (Canvas 2D): palettes with roles, lit materials, 2D lighting and shadows, shapes and character parts, baked sprites and sheets, a glass HUD, rigs and procedural animation, tweens, pooled effects, a camera with feel, parallax scenery and auto-quality. Zero runtime dependencies besides @gp/core; one subpath per module, so a game pays only for what it imports",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./color": "./src/color.ts",
    "./palette": "./src/palette.ts",
    "./noise": "./src/noise.ts",
    "./bake": "./src/bake.ts",
    "./material": "./src/material.ts",
    "./light": "./src/light.ts",
    "./shapes": "./src/shapes.ts",
    "./sprite": "./src/sprite.ts",
    "./hud": "./src/hud.ts",
    "./rig": "./src/rig.ts",
    "./tween": "./src/tween.ts",
    "./fx": "./src/fx.ts",
    "./camera": "./src/camera.ts",
    "./scenery": "./src/scenery.ts",
    "./perf": "./src/perf.ts",
    "./cover": "./src/cover.ts",
    "./assets": "./src/assets.ts",
    "./dom": "./src/dom.ts",
    "./type": "./src/type.ts",
    "./type/dela-gothic-one": "./src/type/dela-gothic-one.ts",
    "./type/nunito-black": "./src/type/nunito-black.ts",
    "./type/exo-2": "./src/type/exo-2.ts",
    "./type/pixel": "./src/type/pixel.ts"
  },
  "dependencies": { "@gp/core": "*" }
}
